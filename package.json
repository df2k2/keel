{
  "name": "keel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A security-first block theme for local service businesses.",
  "license": "GPL-2.0-or-later",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run build:css",
    "lint:js": "wp-scripts lint-js bin tests",
    "lint:css": "wp-scripts lint-style \"src/**/*.css\"",
    "lint:php": "composer lint && composer analyse",
    "check:contrast": "node bin/check-contrast.js",
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "package": "node bin/package.js",
    "env:start": "wp-env start",
    "env:stop": "wp-env stop",
    "env:seed": "bash bin/seed.sh",
    "check:theme": "bash bin/run-theme-check.sh",
    "test:e2e": "playwright test",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "check:licenses": "license-checker-rseidelsohn --production --excludePrivatePackages --onlyAllow \"GPL-2.0;GPL-2.0-or-later;GPL-2.0+;GPL-3.0;GPL-3.0-or-later;LGPL-2.1;LGPL-3.0;MIT;ISC;BSD-2-Clause;BSD-3-Clause;Apache-2.0;0BSD;CC0-1.0;Unlicense;Python-2.0;BlueOak-1.0.0\"",
    "build:fonts": "node bin/build-fonts.js",
    "test:wp": "bash bin/run-wp-tests.sh",
    "build:css": "postcss src/css/keel.css -o build/css/keel.css && postcss src/css/editor.css -o build/css/editor.css && postcss \"src/css/blocks/*.css\" --dir build/css/blocks"
  },
  "devDependencies": {
    "@capsizecss/core": "4.1.3",
    "@capsizecss/metrics": "4.4.0",
    "@playwright/test": "^1.64.1",
    "@wordpress/env": "^12.0.0",
    "@wordpress/scripts": "^37.0.0",
    "@wordpress/stylelint-config": "^27.0.0",
    "archiver": "^8.0.0",
    "cssnano": "^9.9.0",
    "license-checker-rseidelsohn": "^5.0.1",
    "postcss": "^8.5.32",
    "postcss-cli": "^12.0.0",
    "postcss-import": "^17.0.1",
    "postcss-preset-env": "^11.6.1",
    "stylelint-use-logical": "^2.1.3",
    "subset-font": "2.9.0"
  },
  "overrides": {
    "serialize-javascript": "^7.1.4"
  }
}
