{
	"$schema": "https://schemas.wp.org/wp/7.1/theme.json",
	"version": 3,
	"title": "Clinic",
	"settings": {
		"color": {
			"palette": [
				{
					"slug": "base",
					"color": "#FFFFFF",
					"name": "Base"
				},
				{
					"slug": "contrast",
					"color": "#0B2A2F",
					"name": "Contrast"
				},
				{
					"slug": "primary",
					"color": "#0E6B70",
					"name": "Primary"
				},
				{
					"slug": "primary-contrast",
					"color": "#FFFFFF",
					"name": "Primary contrast"
				},
				{
					"slug": "accent",
					"color": "#B5451B",
					"name": "Accent"
				},
				{
					"slug": "accent-contrast",
					"color": "#FFFFFF",
					"name": "Accent contrast"
				},
				{
					"slug": "surface",
					"color": "#F1F8F8",
					"name": "Surface"
				},
				{
					"slug": "surface-alt",
					"color": "#DDEDEE",
					"name": "Surface alt"
				},
				{
					"slug": "border",
					"color": "#6B9496",
					"name": "Border"
				},
				{
					"slug": "success",
					"color": "#1E7D4F",
					"name": "Success"
				},
				{
					"slug": "warning",
					"color": "#8F5600",
					"name": "Warning"
				},
				{
					"slug": "error",
					"color": "#B3261E",
					"name": "Error"
				}
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"slug": "body",
					"name": "Body",
					"fontFamily": "Figtree, \"Figtree Fallback\", Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Figtree",
							"fontStyle": "normal",
							"fontWeight": "300 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/figtree.woff2"
							]
						},
						{
							"fontFamily": "Figtree",
							"fontStyle": "italic",
							"fontWeight": "300 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/figtree-italic.woff2"
							]
						}
					]
				},
				{
					"slug": "display",
					"name": "Display",
					"fontFamily": "Figtree, \"Figtree Fallback\", Arial, sans-serif"
				},
				{
					"slug": "serif",
					"name": "Serif",
					"fontFamily": "Fraunces, \"Fraunces Fallback\", Georgia, serif",
					"fontFace": [
						{
							"fontFamily": "Fraunces",
							"fontStyle": "normal",
							"fontWeight": "300 800",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/fraunces.woff2"
							]
						},
						{
							"fontFamily": "Fraunces",
							"fontStyle": "italic",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/fraunces-italic.woff2"
							]
						}
					]
				}
			]
		},
		"custom": {
			"radius": {
				"none": "0",
				"sm": "6px",
				"md": "12px",
				"lg": "20px",
				"pill": "999px"
			}
		}
	}
}
