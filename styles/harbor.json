{
	"$schema": "https://schemas.wp.org/wp/7.1/theme.json",
	"version": 3,
	"title": "Harbor",
	"settings": {
		"color": {
			"palette": [
				{
					"slug": "base",
					"color": "#FFFFFF",
					"name": "Base"
				},
				{
					"slug": "contrast",
					"color": "#0F1B2D",
					"name": "Contrast"
				},
				{
					"slug": "primary",
					"color": "#1F3A5F",
					"name": "Primary"
				},
				{
					"slug": "primary-contrast",
					"color": "#FFFFFF",
					"name": "Primary contrast"
				},
				{
					"slug": "accent",
					"color": "#8A6D0B",
					"name": "Accent"
				},
				{
					"slug": "accent-contrast",
					"color": "#FFFFFF",
					"name": "Accent contrast"
				},
				{
					"slug": "surface",
					"color": "#F4F6F9",
					"name": "Surface"
				},
				{
					"slug": "surface-alt",
					"color": "#E3E8EF",
					"name": "Surface alt"
				},
				{
					"slug": "border",
					"color": "#7B8698",
					"name": "Border"
				},
				{
					"slug": "success",
					"color": "#1B6F43",
					"name": "Success"
				},
				{
					"slug": "warning",
					"color": "#8F5600",
					"name": "Warning"
				},
				{
					"slug": "error",
					"color": "#B3261E",
					"name": "Error"
				}
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"slug": "body",
					"name": "Body",
					"fontFamily": "Figtree, \"Figtree Fallback\", Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Figtree",
							"fontStyle": "normal",
							"fontWeight": "300 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/figtree.woff2"
							]
						},
						{
							"fontFamily": "Figtree",
							"fontStyle": "italic",
							"fontWeight": "300 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/figtree-italic.woff2"
							]
						}
					]
				},
				{
					"slug": "display",
					"name": "Display",
					"fontFamily": "\"Bricolage Grotesque\", \"Bricolage Grotesque Fallback\", Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Bricolage Grotesque",
							"fontStyle": "normal",
							"fontWeight": "400 800",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/bricolage-grotesque.woff2"
							]
						}
					]
				},
				{
					"slug": "serif",
					"name": "Serif",
					"fontFamily": "Fraunces, \"Fraunces Fallback\", Georgia, serif",
					"fontFace": [
						{
							"fontFamily": "Fraunces",
							"fontStyle": "normal",
							"fontWeight": "300 800",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/fraunces.woff2"
							]
						},
						{
							"fontFamily": "Fraunces",
							"fontStyle": "italic",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/fraunces-italic.woff2"
							]
						}
					]
				}
			]
		},
		"custom": {
			"radius": {
				"none": "0",
				"sm": "4px",
				"md": "8px",
				"lg": "16px",
				"pill": "999px"
			}
		}
	}
}
