{
	"$schema": "https://schemas.wp.org/wp/7.1/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"blocks": {
			"core/image": {
				"lightbox": { "enabled": true, "allowEditing": true }
			}
		},
		"layout": {
			"contentSize": "68rem",
			"wideSize": "90rem"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{ "slug": "base", "color": "#FFFFFF", "name": "Base" },
				{ "slug": "contrast", "color": "#0F1B2D", "name": "Contrast" },
				{ "slug": "primary", "color": "#1F3A5F", "name": "Primary" },
				{ "slug": "primary-contrast", "color": "#FFFFFF", "name": "Primary contrast" },
				{ "slug": "accent", "color": "#8A6D0B", "name": "Accent" },
				{ "slug": "accent-contrast", "color": "#FFFFFF", "name": "Accent contrast" },
				{ "slug": "surface", "color": "#F4F6F9", "name": "Surface" },
				{ "slug": "surface-alt", "color": "#E3E8EF", "name": "Surface alt" },
				{ "slug": "border", "color": "#7B8698", "name": "Border" },
				{ "slug": "success", "color": "#1B6F43", "name": "Success" },
				{ "slug": "warning", "color": "#8F5600", "name": "Warning" },
				{ "slug": "error", "color": "#B3261E", "name": "Error" }
			]
		},
		"typography": {
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "body",
					"name": "Body",
					"fontFamily": "Figtree, \"Figtree Fallback\", Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Figtree",
							"fontStyle": "normal",
							"fontWeight": "300 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/figtree.woff2"
							]
						},
						{
							"fontFamily": "Figtree",
							"fontStyle": "italic",
							"fontWeight": "300 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/figtree-italic.woff2"
							]
						}
					]
				},
				{
					"slug": "display",
					"name": "Display",
					"fontFamily": "\"Bricolage Grotesque\", \"Bricolage Grotesque Fallback\", Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Bricolage Grotesque",
							"fontStyle": "normal",
							"fontWeight": "400 800",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/bricolage-grotesque.woff2"
							]
						}
					]
				}
			],
			"fontSizes": [
				{ "slug": "xs", "name": "Extra small", "size": "0.875rem", "fluid": { "min": "0.8125rem", "max": "0.875rem" } },
				{ "slug": "sm", "name": "Small", "size": "1rem", "fluid": { "min": "0.875rem", "max": "1rem" } },
				{ "slug": "md", "name": "Medium", "size": "1.125rem", "fluid": { "min": "1rem", "max": "1.125rem" } },
				{ "slug": "lg", "name": "Large", "size": "1.375rem", "fluid": { "min": "1.125rem", "max": "1.375rem" } },
				{ "slug": "xl", "name": "Extra large", "size": "1.75rem", "fluid": { "min": "1.375rem", "max": "1.75rem" } },
				{ "slug": "xxl", "name": "2X large", "size": "2.5rem", "fluid": { "min": "1.75rem", "max": "2.5rem" } },
				{ "slug": "xxxl", "name": "3X large", "size": "3.5rem", "fluid": { "min": "2.25rem", "max": "3.5rem" } }
			]
		},
		"spacing": {
			"spacingScale": { "steps": 0 },
			"spacingSizes": [
				{ "slug": "10", "name": "3X small", "size": "0.25rem" },
				{ "slug": "20", "name": "2X small", "size": "0.5rem" },
				{ "slug": "30", "name": "Extra small", "size": "clamp(0.75rem, 1.5vw, 1rem)" },
				{ "slug": "40", "name": "Small", "size": "clamp(1rem, 2vw, 1.5rem)" },
				{ "slug": "50", "name": "Medium", "size": "clamp(1.5rem, 3vw, 2.5rem)" },
				{ "slug": "60", "name": "Large", "size": "clamp(2rem, 4vw, 4rem)" },
				{ "slug": "70", "name": "Extra large", "size": "clamp(3rem, 6vw, 6rem)" },
				{ "slug": "80", "name": "2X large", "size": "clamp(4rem, 8vw, 8rem)" }
			],
			"units": [ "px", "em", "rem", "vh", "vw", "%" ]
		},
		"custom": {
			"radius": { "none": "0", "sm": "4px", "md": "8px", "lg": "16px", "pill": "999px" },
			"shadow": { "sm": "0 1px 2px rgb(15 27 45 / 0.08)", "md": "0 8px 24px rgb(15 27 45 / 0.12)" },
			"border": { "width": "1px" },
			"focus": { "ring": "2px solid var(--wp--preset--color--primary)", "offset": "2px" },
			"typography": {
				"lineHeight": { "tight": "1.15", "snug": "1.3", "normal": "1.6" },
				"letterSpacing": { "tight": "-0.01em", "normal": "0", "wide": "0.04em" }
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--md)",
			"lineHeight": "var(--wp--custom--typography--line-height--normal)"
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--40)",
			"padding": {
				"top": "0",
				"right": "var(--wp--preset--spacing--40)",
				"bottom": "0",
				"left": "var(--wp--preset--spacing--40)"
			}
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--primary)" },
				"typography": { "textDecoration": "underline" }
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--primary-contrast)"
				},
				"border": { "radius": "var(--wp--custom--radius--md)" }
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "700",
					"lineHeight": "var(--wp--custom--typography--line-height--tight)"
				}
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xxxl)" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--xxl)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--xl)" } },
			"h4": { "typography": { "fontSize": "var(--wp--preset--font-size--lg)" } },
			"h5": { "typography": { "fontSize": "var(--wp--preset--font-size--md)" } },
			"h6": { "typography": { "fontSize": "var(--wp--preset--font-size--md)" } }
		}
	},
	"customTemplates": [
		{ "name": "page-no-title", "title": "Page without title", "postTypes": [ "page" ] },
		{ "name": "page-landing", "title": "Landing page", "postTypes": [ "page" ] },
		{ "name": "page-service", "title": "Service page", "postTypes": [ "page" ] },
		{ "name": "page-location", "title": "Location page", "postTypes": [ "page" ] }
	],
	"templateParts": [
		{ "name": "header", "area": "header", "title": "Header" },
		{ "name": "header-centered", "area": "header", "title": "Header: centered" },
		{ "name": "header-transparent", "area": "header", "title": "Header: transparent" },
		{ "name": "footer", "area": "footer", "title": "Footer" },
		{ "name": "footer-minimal", "area": "footer", "title": "Footer: minimal" },
		{ "name": "cta-band", "area": "uncategorized", "title": "Call-to-action band" },
		{ "name": "mobile-cta-bar", "area": "uncategorized", "title": "Mobile CTA bar" },
		{ "name": "announcement-bar", "area": "uncategorized", "title": "Announcement bar" },
		{ "name": "post-meta", "area": "uncategorized", "title": "Post meta" },
		{ "name": "comments", "area": "uncategorized", "title": "Comments" }
	]
}
